# Copy this file to ".env" and adjust only if you need to.
# The defaults already work for the current public-read setup.

# Firestore
FIRESTORE_PROJECT_ID=opa-need
FIRESTORE_DATABASE_ID=(default)

# Optional authorised access - leave EMPTY unless the project owner
# tightens the Firestore rules and gives you authorised read access.
# Option A: path to a service-account JSON (role: Cloud Datastore Viewer only)
GOOGLE_SERVICE_ACCOUNT_FILE=
# Option B: a short-lived OAuth2 access token (expires, for testing only)
FIRESTORE_ACCESS_TOKEN=

# Server
SECRET_KEY=change-this-to-a-long-random-text
PORT=5000
FLASK_DEBUG=0

# Limits
RATE_LIMIT_PER_MINUTE=90
CACHE_TTL_SECONDS=45
